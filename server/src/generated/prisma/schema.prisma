generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  fullName        String
  hashedPassword  String
  salt            String
  role            UserRoleEnum
  telegramUser    TelegramUser?
  accountSessions AccountSession[]
  news            News[]
  menus           Menu[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
}

model TelegramUser {
  id         Int       @id @default(autoincrement())
  telegramId BigInt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     Int       @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
}

model AccountSession {
  id        Int      @id @default(autoincrement())
  device    Json
  ip        String
  sessionId String   @unique
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int
  exp       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique([userId, device, ip])
}

model News {
  id           Int          @id @default(autoincrement())
  title        String
  path         String       @unique
  description  String
  languageCode String?
  isArchived   Boolean      @default(false)
  isCheck      Boolean      @default(true)
  isTop        Boolean      @default(false)
  type         NewsTypeEnum
  content      Json[]
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorId     Int?
  files        File[]
  tags         NewsTag[]
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt

  @@unique([languageCode, path])
}

model NewsTag {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  languageCode String?
  news         News[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  @@unique([languageCode, name])
}

model Contact {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  href      String
  fileName  String?
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model File {
  id        Int       @id @default(autoincrement())
  name      String
  mimeType  String
  extension String
  news      News?     @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  newsId    Int?
  menu      Menu?     @relation(fields: [menuId], references: [id])
  menuId    Int?
  banner    Banner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  Partner   Partner[]

  @@unique([newsId, name])
  @@unique([menuId, name])
}

model Place {
  id              Int               @id @default(autoincrement())
  title           String            @unique
  name            String?
  languageCode    String?
  interactiveArea InteractiveArea[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt

  @@unique([name, title, languageCode])
}

model InteractiveArea {
  id               Int       @id @default(autoincrement())
  chairmanFullName String
  chairmanPhoto    String
  phoneNumber      String?
  email            String?
  workingTime      String?
  address          String
  membersCount     Int       @default(0)
  place            Place     @relation(fields: [placeId], references: [id])
  placeId          Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
}

model Banner {
  id        Int            @id @default(autoincrement())
  type      BannerTypeEnum
  url       String
  file      File           @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
}

model Partner {
  id        Int       @id @default(autoincrement())
  title     String
  icon      File      @relation(fields: [iconId], references: [id])
  iconId    Int
  url       String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Menu {
  id           Int           @id @default(autoincrement())
  name         String
  path         String?
  languageCode String?
  type         MenuTypeEnum?
  newsType     NewsTypeEnum?
  isPin        Boolean       @default(false)
  isVisible    Boolean       @default(false)
  content      Json[]
  parent       Menu?         @relation(name: "parent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     Int?
  children     Menu[]        @relation("parent")
  files        File[]
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId       Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  @@unique([path, parentId, name])
}

enum MenuTypeEnum {
  text
  document
  member
  news
  photo
}

model Appeal {
  id                   Int       @id @default(autoincrement())
  fullName             String
  phoneNumber          String
  option               String
  email                String
  questionOrSuggestion String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt
}

